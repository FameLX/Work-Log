{"nodes": [{"id": "claude_skills_apple_design_skill", "label": "Apple Design Skill (.claude)", "file_type": "document", "source_file": ".claude/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_apple_design_skill_interruptibility", "label": "Interruptibility Principle", "file_type": "concept", "source_file": ".claude/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apple's WWDC guidance holds that every animation must be interruptible and redirectable at any moment because the user's thought and gesture happen in parallel; locking input during a transition breaks the illusion of direct manipulation."}, {"id": "claude_skills_apple_design_skill_velocity_handoff", "label": "Velocity Handoff", "file_type": "concept", "source_file": ".claude/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_apple_design_skill_momentum_projection", "label": "Momentum Projection", "file_type": "concept", "source_file": ".claude/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_apple_design_skill_rubber_banding", "label": "Rubber-banding (Soft Boundaries)", "file_type": "concept", "source_file": ".claude/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_apple_design_skill_eight_design_principles", "label": "Apple's Eight Design Principles", "file_type": "concept", "source_file": ".claude/skills/apple-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Purpose, Agency, Responsibility, Familiar